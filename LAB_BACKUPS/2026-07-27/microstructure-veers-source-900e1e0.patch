+        return original(
+            family,
+            trial,
+            split,
+            protocol_value,
+            record,
+            **kwargs,
+        )
+
+    class SimulatedDisconnect(RuntimeError):
+        pass
+
+    def interrupt(record):
+        checkpoint.update(record)
+        raise SimulatedDisconnect
+
+    monkeypatch.setattr(
+        runner_module,
+        "_evaluate_non_tensor_trial_fold",
+        counted,
+    )
+    with pytest.raises(SimulatedDisconnect):
+        evaluate_non_tensor_search_streamed(
+            data,
+            protocol(),
+            "persistence",
+            folds,
+            trials,
+            trial_callback=interrupt,
+        )
+
+    assert calls == ["persistence-one"]
+    assert checkpoint["trial_id"] == "persistence-one"
+    assert checkpoint["completed_inner_folds"] == 1
+
