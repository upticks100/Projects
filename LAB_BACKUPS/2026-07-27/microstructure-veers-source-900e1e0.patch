+def normalize_target_ridge_alpha(value: Any) -> float | str:
+    if value == TARGET_RIDGE_INTERCEPT_ONLY:
+        return TARGET_RIDGE_INTERCEPT_ONLY
+    if isinstance(value, bool):
+        raise SafetyError("target Ridge alpha must be numeric or intercept_only")
+    try:
+        alpha = float(value)
+    except (TypeError, ValueError) as error:
+        raise SafetyError(
+            "target Ridge alpha must be numeric or intercept_only"
+        ) from error
+    if not math.isfinite(alpha) or alpha < 0:
+        raise SafetyError("target Ridge alpha must be finite and nonnegative")
+    return alpha
 
 
