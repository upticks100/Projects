--- a/tests/test_tucker_booster.py
+++ b/tests/test_tucker_booster.py
@@ -3,6 +3,8 @@ import numpy as np
 from microstructure_veer.tensor_models.tucker_booster import (
     TuckerConfig,
     fit_tucker_booster,
+    fit_tucker_head,
+    fit_tucker_representation,
     predict_tucker_booster,
     tucker_diagnostics,
     _masked_output_scores,
@@ -80,6 +82,41 @@ def test_tucker_masked_target_value_does_not_change_fit() -> None:
     assert "converged" in tucker_diagnostics(first)
 
 
+def test_tucker_excludes_fully_unobserved_output_score_samples() -> None:
+    rng = np.random.default_rng(131)
+    X = rng.normal(size=(10, 2, 2, 2))
+    residual = rng.normal(size=(10, 2, 1))
+    mask = np.ones_like(residual, dtype=bool)
+    mask[:2] = False
+    config = TuckerConfig(
+        input_ranks=(1, 1, 1),
+        output_ranks=(1, 1),
+        regularization=1.0,
+        max_iter=2,
+        initialization="svd",
+        seed=131,
+    )
+
+    representation = fit_tucker_representation(X, residual, mask, config)
+    first = fit_tucker_head(representation, config)
+    changed = residual.copy()
+    changed[:2] = 1.0e20
+    second = fit_tucker_booster(X, changed, mask, config)
+
+    np.testing.assert_allclose(
+        predict_tucker_booster(first, X),
+        predict_tucker_booster(second, X),
+    )
+    assert representation.train_x_core.shape[0] == 8
+    assert representation.train_output_scores.shape[0] == 8
+    diagnostics = tucker_diagnostics(first)
+    assert diagnostics["output_score_skipped_unobserved_samples"] == 2
+    assert (
+        diagnostics["missing_target_policy"]
+        == "mask_aware_spatial_score_least_squares_with_empty_sample_exclusion"
+    )
+
+
 def test_tucker_output_scores_reconstruct_observed_low_rank_targets() -> None:
     rng = np.random.default_rng(14)
     firm_factor, _ = np.linalg.qr(rng.normal(size=(4, 2)))
