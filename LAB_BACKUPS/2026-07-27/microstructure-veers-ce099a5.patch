@@ -95,6 +110,29 @@ def test_protocol_rejects_incomplete_factor_rank_search(tmp_path: Path) -> None:
         TournamentProtocol.from_yaml(changed)
 
 
+@pytest.mark.parametrize(
+    ("parameter", "old_boundary_limited_values"),
+    [
+        ("l2_regularization", [0.0, 1.0, 10.0]),
+        ("max_iter", [50, 100, 300, 600]),
+    ],
+)
+def test_protocol_rejects_old_gradient_boosting_boundaries(
+    tmp_path: Path,
+    parameter: str,
+    old_boundary_limited_values: list[float | int],
+) -> None:
+    payload = yaml.safe_load(PROTOCOL.read_text(encoding="utf-8"))
+    payload["model_families"]["gradient_boosting"][
+        parameter
+    ] = old_boundary_limited_values
+    changed = tmp_path / "protocol.yaml"
+    changed.write_text(yaml.safe_dump(payload), encoding="utf-8")
+
+    with pytest.raises(SafetyError, match="expand beyond"):
+        TournamentProtocol.from_yaml(changed)
+
+
 def test_protocol_rejects_target_ridge_without_natural_endpoint(
     tmp_path: Path,
 ) -> None:
